# Student Learning Portal - Frontend Environment Variables
# API Gateway Target (Default port 8080)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Portal Configuration
VITE_PORTAL_NAME="Student Learning Portal"
VITE_PORTAL_ENV=development


# Backend JWT signing key (use a unique random value; keep .env private)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional first-run evaluation accounts; leave empty to disable account seeding
PORTAL_SEED_STUDENT_PASSWORD=
PORTAL_SEED_ADMIN_PASSWORD=
