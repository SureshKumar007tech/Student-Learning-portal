# ==============================================================================
# Student Learning Portal - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_PORTAL_NAME="Student Learning Portal"
VITE_PORTAL_ENV=development

# Security: JWT Signing Secret (CRITICAL: Must be at least 32 characters long / 256 bits)
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters

# Service-to-Service Trust: Internal Gateway Secret (Defaults to JWT_SECRET if unset)
# GATEWAY_INTERNAL_SECRET=replace-with-dedicated-internal-gateway-secret-32chars

# Database Seeding: Opt-in demo / evaluation data (true for dev evaluation, false for production)
PORTAL_SEED_ENABLED=false
PORTAL_SEED_STUDENT_PASSWORD=
PORTAL_SEED_ADMIN_PASSWORD=

# Production PostgreSQL Configuration (used when SPRING_PROFILES_ACTIVE=postgres)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portal_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
